{
  "name": "vouchlist",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "node scripts/gen-lastmod.mjs && vite build",
    "build:dev": "node scripts/gen-lastmod.mjs && vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint .",
    "qa:copy": "node scripts/copy-qa.mjs",
    "qa:copy:ai": "node scripts/copy-qa.mjs --ai",
    "format": "prettier --write .",
    "qa:seo": "node scripts/seo-qa.mjs",
    "qa:image": "node scripts/image-qa.mjs",
    "qa:all": "node scripts/image-qa.mjs && node scripts/copy-qa.mjs && node scripts/seo-qa.mjs && node scripts/private-routes-qa.mjs && node scripts/link-qa.mjs && node scripts/security-qa.mjs && node scripts/secrets-qa.mjs && node scripts/deps-qa.mjs && node scripts/rls-qa.mjs && bun run scripts/spam-qa.ts && node scripts/a11y-qa.mjs && node scripts/a11y-form-qa.mjs && vitest run && playwright test && node scripts/perf-qa.mjs",
    "qa:private": "node scripts/private-routes-qa.mjs",
    "qa:links": "node scripts/link-qa.mjs",
    "qa:security": "node scripts/security-qa.mjs",
    "qa:security:strict": "node scripts/security-qa.mjs --require-enforce",
    "qa:e2e": "playwright test",
    "qa:a11y": "node scripts/a11y-qa.mjs",
    "qa:perf": "node scripts/perf-qa.mjs",
    "qa:deps": "node scripts/deps-qa.mjs",
    "qa:secrets": "node scripts/secrets-qa.mjs",
    "qa:rls": "node scripts/rls-qa.mjs",
    "qa:spam": "bun run scripts/spam-qa.ts",
    "qa:perf:dashboard": "node scripts/perf-dashboard.mjs --run --open",
    "qa:perf:report": "node scripts/perf-dashboard.mjs --open",
    "qa:a11y:forms": "node scripts/a11y-form-qa.mjs",
    "sitemap:lastmod": "node scripts/gen-lastmod.mjs",
    "qa:unit": "vitest run",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "coverage:badge": "node scripts/coverage-badge.mjs",
    "prepare": "husky"
  },
